REC_ENV=prod

# Base URL (without trailing slash)
REC_API_BASE_URL=http://localhost:8000/api
REC_FRONTEND_BASE_URL=http://localhost:5173

# Replay upload endpoint (path only, domain from API_BASE_URL)
REC_REPLAY_API_URL=/admin/replay/upload

# Admin API key
REC_API_KEY=ffk_your_admin_api_key_here

# Google OAuth — shared client for YouTube and Google Drive
REC_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
REC_GOOGLE_CLIENT_SECRET=your_client_secret
REC_YOUTUBE_REFRESH_TOKEN=your_refresh_token

# YouTube video privacy: "public", "unlisted" (default), or "private"
REC_YOUTUBE_PRIVACY_STATUS=unlisted

# YouTube priority by member nickname; comma-separated, highest priority first.
# Within each group, largest MP4 first. Empty = largest MP4 first for all members.
REC_YOUTUBE_UPLOAD_PRIORITY=

# Google Drive backup — separate account/token allowed; private JKT48Live folder is automatic
REC_BACKUP_TO_GDRIVE=false
REC_GDRIVE_REFRESH_TOKEN=
# Independent backup-job limit; does not use REC_MAX_CONCURRENT_UPLOADS
REC_GDRIVE_MAX_CONCURRENT_UPLOADS=1

# Process pending Drive archives through YouTube; false = backup only
REC_GDRIVE_TO_YOUTUBE=false

# Permanent deletion after YouTube completion; start with false
REC_GDRIVE_DELETE_AFTER_YOUTUBE_UPLOAD=false
# Retain these member nicknames; comma-separated, case-insensitive.
# Previously retained completed archives stay retained after this list changes.
REC_GDRIVE_KEEP_MEMBERS=

# Telegram Channel Notification
REC_TELEGRAM_ENABLED=false
REC_TELEGRAM_BOT_TOKEN=your_telegram_bot_token
REC_TELEGRAM_CHAT_ID=@your_channel_username_or_id

# Page48 Notification
REC_PAGE48_ENABLED=false
REC_PAGE48_API_KEY=your_page48_api_key
# Only needed when Page48 runs on a different host than REC_API_BASE_URL
# REC_PAGE48_BASE_URL=https://mypage48.com/api

# Logging: "stdout" (default) or "file" → separate files in REC_LOGS_DIR, including gdrive.log
REC_LOG_MODE=stdout

# Optional — override defaults
# REC_ENABLE_FLARESOLVERR=false
# REC_FLARESOLVERR_URL=http://localhost:8191/v1
# REC_POLL_INTERVAL=10
# REC_HEALTH_CHECK_INTERVAL=300
# REC_HEARTBEAT_INTERVAL=120
# REC_NEWS_CHECK_INTERVAL=300
# REC_SCHEDULE_CHECK_INTERVAL=300
# REC_SHOWROOM_COMMENT_INTERVAL=2.0
# REC_SHOWROOM_GIFT_INTERVAL=5.0
# REC_RECORDINGS_DIR=./recordings
# REC_THEATER_DIR=./theater
# REC_LOGS_DIR=./logs
# REC_MAX_RECORDING_HOURS=4
# REC_REMUX_TIMEOUT=600
# REC_MAX_CONCURRENT_UPLOADS=2
# REC_ENABLE_UPLOAD_QUEUE=true
# REC_YOUTUBE_UPLOAD_DELAY_MINUTES=30
# REC_LOG_LEVEL=INFO
