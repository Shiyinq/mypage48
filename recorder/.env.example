# Base URL (without trailing slash)
REC_API_BASE_URL=http://localhost:8000/api
REC_FRONTEND_BASE_URL=http://localhost:5173

# Replay upload endpoint (path only, domain from API_BASE_URL)
REC_REPLAY_API_URL=/admin/replay/upload

# Admin API key
REC_API_KEY=ffk_your_admin_api_key_here

# Google OAuth — YouTube upload
REC_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
REC_GOOGLE_CLIENT_SECRET=your_client_secret
REC_YOUTUBE_REFRESH_TOKEN=your_refresh_token

# YouTube video privacy: "public", "unlisted" (default), or "private"
REC_YOUTUBE_PRIVACY_STATUS=unlisted

# Telegram Channel Notification
REC_TELEGRAM_BOT_TOKEN=your_telegram_bot_token
REC_TELEGRAM_CHAT_ID=@your_channel_username_or_id

# Logging: "stdout" (default) or "file" → recorder/logs/{recorder,uploader}.log
REC_LOG_MODE=stdout

# Optional — override defaults
# REC_POLL_INTERVAL=10
# REC_HEALTH_CHECK_INTERVAL=300
# REC_HEARTBEAT_INTERVAL=120
# REC_NEWS_CHECK_INTERVAL=300
# REC_SCHEDULE_CHECK_INTERVAL=300
# REC_SHOWROOM_COMMENT_INTERVAL=2.0
# REC_SHOWROOM_GIFT_INTERVAL=5.0
# REC_RECORDINGS_DIR=./recordings
# REC_THEATER_DIR=./theater
# REC_LOGS_DIR=./logs
# REC_MAX_RECORDING_HOURS=4
# REC_REMUX_TIMEOUT=600
# REC_MAX_CONCURRENT_UPLOADS=2
# REC_ENABLE_UPLOAD_QUEUE=true
# REC_LOG_LEVEL=INFO
