# ==========================================
# MYPAGE48 PRODUCTION ENVIRONMENT TEMPLATE
# ==========================================
# Instructions:
# 1. Copy this file to .env on your server
# 2. Fill in ALL empty values
# 3. Use strong, unique passwords for everything

# --- CORE SETTINGS ---
ENV=prod
LOG_LEVEL=info
LOG_DESTINATION=file
LOG_PATH=/var/log/mypage48/

# --- URLS (CRITICAL - DO NOT USE LOCALHOST) ---
# Main App Domain
FRONTEND_URL=https://mypage48.com
# Public API Domain (Used by Frontend build)
PUBLIC_CLIENT_SIDE_API_BASE_URL=https://api.mypage48.com

# API Base URL (Used by Backend for internal logic)
API_BASE_URL=https://api.mypage48.com
# CORS Origins (Comma separated)
ORIGINS=https://mypage48.com,https://api.mypage48.com,https://analytics.mypage48.com,https://storage.mypage48.com
# Cookie Domain (Set to apex domain for cross-subdomain support)
COOKIE_DOMAIN=mypage48.com

# --- SECURITY ---
# Generate a random 32+ character string (e.g. openssl rand -hex 32)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_MAX_AGE_DAYS=30

# --- DATABASE ---
# Root credentials (Required for production auth)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=ChangeThisExtremeleyLongPassword

# MONGODB_URI is handled internally by docker-compose, 
# but you can specify the DB name here.
DB_NAME=mypage48
DB_MAX_POOL_SIZE=100

# --- STORAGE (Compatible with MinIO and Cloudflare R2) ---
# Set to 'r2' for production to save RAM and use Presigned URLs
STORAGE_PROVIDER=r2
# For R2: <account_id>.r2.cloudflarestorage.com
# For MinIO: minio:9000
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=mypage48-images
STORAGE_SECURE=true
# Set to true for R2 to offload image delivery to Cloudflare CDN
STORAGE_USE_PRESIGNED=true
# Public storage domain (optional for R2, required for MinIO)
STORAGE_PUBLIC_URL=https://storage.mypage48.com

# --- OAUTH ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://api.mypage48.com/auth/github/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.mypage48.com/auth/google/callback

# --- AI & EMAIL ---
GEMINI_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=noreply@mypage48.com

# --- ANALYTICS (Umami) ---
# Generate a random string for UMAMI_SECRET
UMAMI_SECRET=
# Domain where Umami is hosted
PUBLIC_UMAMI_URL=https://analytics.mypage48.com
# Website ID from Umami dashboard (Fill after initial setup)
PUBLIC_UMAMI_WEBSITE_ID=

# Umami Postgres DB
POSTGRES_DB=umami
POSTGRES_USER=umami
POSTGRES_PASSWORD=ChangeThisPostgresPassword

# --- AUTH SECURITY & LIMITERS ---
# Account security settings
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
# Rate limiting (requests per minute)
AUTH_REQUESTS_PER_MINUTE=60
DEFAULT_REQUESTS_PER_MINUTE=120
LIVE_PROXY_REQUESTS_PER_MINUTE=1500

# --- VERIFICATION & EXPIRATION ---
# Email and token expiration times
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1

# --- BACKUP (Cloudflare R2) ---
# Password to encrypt your .7z backup files
BACKUP_PASSWORD=
# Cloudflare R2 Credentials
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_ACCOUNT_ID=
