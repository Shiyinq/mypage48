# FASTAPI
ENV=dev
LOG_LEVEL=debug
LOG_DESTINATION=console
LOG_PATH=/var/log/mypage48/
API_BASE_URL=http://localhost:8000/api
ORIGINS=http://localhost:5050,http://localhost:5000,http://localhost:5173
MAX_UPLOAD_SIZE_BYTES=10485760

# MONGODB
MONGODB_URI=mongodb://localhost:27017
DB_NAME=mypage48
DB_MAX_POOL_SIZE=50

# FRONTEND URL
FRONTEND_URL=http://localhost:5173

# JWT
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_MAX_AGE_DAYS=30

# GITHUB
OAUTHLIB_INSECURE_TRANSPORT=1
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# GOOGLE
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# GEMINI
GEMINI_API_KEY=

# RESEND API
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev

# VERIFICATION EXPIRE
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1

# AUTH SECURITY & LIMITER
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
AUTH_REQUESTS_PER_MINUTE=60
DEFAULT_REQUESTS_PER_MINUTE=120
LIVE_PROXY_REQUESTS_PER_MINUTE=1500

# STORAGE SETTINGS
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_BUCKET=mypage48-images
STORAGE_SECURE=false
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_USE_PRESIGNED=false